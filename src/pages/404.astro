---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Page Not Found – Penalty Shooters 2"
  description="This page doesn't exist. Head back to play Penalty Shooters 2 free online."
  canonical="https://penaltyshooters2.co.uk/404/"
>
  <Header slot="header" />
  <main>
    <div class="container not-found">
      <p class="big-num">404</p>
      <h1>Page not found</h1>
      <p>That URL doesn't exist. The penalty was saved.</p>
      <a href="/" class="btn">Back to the game →</a>
    </div>
  </main>
  <Footer slot="footer" />
</Base>

<style>
  .not-found {
    text-align: center;
    padding: 4rem 1rem;
  }
  .big-num {
    font-size: 6rem;
    font-weight: 900;
    color: var(--green);
    line-height: 1;
    margin: 0;
  }
  .not-found h1 { margin-top: 0.25rem; }
  .not-found p { color: var(--text-muted); margin-top: 0.5rem; }
  .btn { margin-top: 1.5rem; }
</style>
