---
const nav = [
  { href: '/', label: 'Play' },
  { href: '/unblocked/', label: 'Unblocked' },
  { href: '/how-to-play/', label: 'How to Play' },
  { href: '/faq/', label: 'FAQ' },
];

const path = Astro.url.pathname;
---
<header>
  <div class="container hdr-inner">
    <a href="/" class="logo" aria-label="Penalty Shooters 2 – Home">
      <span class="logo-icon">⚽</span>
      <span class="logo-text">Penalty Shooters 2</span>
    </a>
    <nav aria-label="Main navigation">
      <ul>
        {nav.map(({ href, label }) => (
          <li>
            <a href={href} class={path === href ? 'active' : ''}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  header {
    background: var(--green-dark);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }
  .hdr-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 56px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--white);
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    flex-shrink: 0;
  }
  .logo-icon { font-size: 1.3rem; }
  .logo:hover { color: #c8f7c8; }

  nav { margin-left: auto; }
  nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
  }
  nav a {
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.15s;
  }
  nav a:hover, nav a.active {
    background: rgba(255,255,255,0.15);
    color: var(--white);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    margin-left: auto;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.2s;
  }

  @media (max-width: 620px) {
    .nav-toggle { display: flex; }
    nav {
      display: none;
      position: absolute;
      top: 56px;
      left: 0;
      right: 0;
      background: var(--green-dark);
      padding: 0.75rem 1.25rem 1rem;
    }
    nav.open { display: block; }
    nav ul { flex-direction: column; gap: 0; }
    nav a { display: block; padding: 0.6rem 0.5rem; }
    .hdr-inner { position: relative; }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.querySelector('header nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
